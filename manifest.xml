<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>1636d60d-998e-468b-91c2-35bff7c8a4af</Id>
  <Version>1.0.0.4</Version>
  <ProviderName>Cognivance</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ST_File Transfers V1"/>
  <Description DefaultValue="A file Transfer add-in."/>
  <IconUrl DefaultValue="https://localhost:8444/outlook/assets/ST-64x64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8444/outlook/assets/ST-128x128.png"/>
  <SupportUrl DefaultValue="https://www.cognivance.com/lets-connect"/>
  <AppDomains>
    <AppDomain>https://www.cognivance.com</AppDomain>
    <AppDomain>https://localhost:8444</AppDomain>
</AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
  <Form xsi:type="ItemEdit">
    <DesktopSettings>
      <SourceLocation DefaultValue="https://localhost:8444/outlook/taskpane.html"/>
    </DesktopSettings>
  </Form>
</FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

  <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" MinVersion="1.5"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>

                <!-- Button 1 -->
                <Control xsi:type="Button" id="SelectLocalFile">
                  <Label resid="SelectFile.Label"/>

                  <Supertip>
                    <Title resid="SelectFile.Label"/>
                    <Description resid="SelectFile.Description"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Select.Url"/>
                  </Action>
                </Control>

                <!-- Button 2 -->
                <Control xsi:type="Button" id="OpenTaskPane">
                  <Label resid="OpenPane.Label"/>

                  <Supertip>
                    <Title resid="OpenPane.Label"/>
                    <Description resid="OpenPane.Description"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:8444/outlook/assets/ST-16x16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://localhost:8444/outlook/assets/ST-32x32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://localhost:8444/outlook/assets/ST-80x80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url"
                DefaultValue="https://localhost:8444/outlook/taskpane.html"/>

        <bt:Url id="Taskpane.Select.Url"
                DefaultValue="https://localhost:8444/outlook/taskpane.html?mode=select"/>

        <bt:Url id="Commands.Url"
                DefaultValue="https://localhost:8444/outlook/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Secure Transfer"/>
        <bt:String id="Menu.Label" DefaultValue="Secure Transfer"/>
        <bt:String id="SelectFile.Label" DefaultValue="Select Local File"/>
        <bt:String id="OpenPane.Label" DefaultValue="Open Task Pane"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Menu.Description"
                   DefaultValue="Secure file transfer tools"/>

        <bt:String id="SelectFile.Description"
                   DefaultValue="Choose a local file and generate a secure download link."/>

        <bt:String id="OpenPane.Description"
                   DefaultValue="Open the Secure Transfer task pane."/>
      </bt:LongStrings>
    </Resources>
   </VersionOverrides>
</VersionOverrides>
</OfficeApp>
